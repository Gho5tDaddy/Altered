{
  "name": "altered-rules-engine",
  "version": "0.29.5",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc && node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:hosted": "node scripts/serve-hosted.mjs",
    "serve:lan": "node scripts/serve.mjs --lan",
    "start": "npm run build && npm run serve",
    "start:lan": "npm run build && npm run serve:lan",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "verify": "npm run typecheck && npm test",
    "browser:audit": "node scripts/browser-audit.mjs",
    "audit": "npm run verify && npm run browser:audit && node scripts/audit.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "pdfjs-dist": "5.4.54",
    "tesseract.js": "^6.0.1"
  }
}
