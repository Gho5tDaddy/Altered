{
  "name": "altered-rules-engine",
  "version": "0.24.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc && node scripts/build.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:lan": "node scripts/serve.mjs --lan",
    "start": "npm run build && npm run serve",
    "start:lan": "npm run build && npm run serve:lan",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "verify": "npm run typecheck && npm test",
    "audit": "npm run verify && node scripts/audit.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
